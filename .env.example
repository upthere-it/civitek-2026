# Copia in .env (non versionato). I default qui sotto vanno bene per lo sviluppo locale.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sp_dev
DB_PASSWORD=sp_dev
DB_NAME=sneaker_passport_dev
# DB usato da `npm test` (viene azzerato a ogni run)
DB_TEST_NAME=sneaker_passport_test
# db:reset è permesso solo se il nome del DB finisce con _dev, _test o _staging
PORT=3000
# Segreto per i codici di recupero (>= 32 caratteri, obbligatorio in produzione; NON cambiarlo dopo il lancio:
# i codici già mostrati smetterebbero di funzionare). Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECOVERY_SECRET=

# Copia in .env (non versionato). I default qui sotto vanno bene per lo sviluppo locale.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sp_dev
DB_PASSWORD=sp_dev
DB_NAME=sneaker_passport_dev
# DB usato da `npm test` (viene azzerato a ogni run)
DB_TEST_NAME=sneaker_passport_test
# db:reset è permesso solo se il nome del DB finisce con _dev, _test o _staging
PORT=3000
# In produzione 127.0.0.1 (lo imposta ecosystem.config.js): il server si raggiunge solo passando da nginx
# HOST=127.0.0.1
# Certificazione su Commercio.network via API commercio.app (chain.notary = "commercio" in game_config.json).
# Stesse variabili di @mvl/commercio-network (repo microservices). Ambiente dev = testnet.
CN_USERNAME=
CN_PASSWORD=
CN_RECIPIENT_ADDRESS=
# /api/health?full=1 (login e saldo commercio.app) risponde solo con l'header x-health-token uguale a questo.
# Vuoto = controllo completo spento. Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HEALTH_TOKEN=
